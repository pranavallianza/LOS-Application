NEXT_PUBLIC_API_URL=http://localhost:8080

NEXT_PUBLIC_LOOKUPS_ROUTE=/lookups
NEXT_PUBLIC_LOOKUP_BY_ID_ROUTE=/lookups/{lookupId}
NEXT_PUBLIC_LOOKUP_STATUS_ROUTE=/lookups/{lookupId}/status
NEXT_PUBLIC_LOOKUP_SUBLOOKUPS_ROUTE=/lookups/{lookupCode}/sub-lookups
NEXT_PUBLIC_SUBLOOKUP_BY_ID_ROUTE=/sub-lookups/{subLookupId}
NEXT_PUBLIC_SUBLOOKUP_STATUS_ROUTE=/sub-lookups/{subLookupId}/status